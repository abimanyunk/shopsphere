{
  "name": "@shopsphere/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "pg": "8.23.1",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
