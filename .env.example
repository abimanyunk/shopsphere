# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000
DEPENDENCY_TIMEOUT_MS=2000
SESSION_TTL_SECONDS=604800
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CATALOG_CACHE_TTL_SECONDS=60
LOW_STOCK_THRESHOLD=5

# Browser origin allowed to send credentialed API requests
CORS_ORIGIN=http://localhost:5173

# Local development dependencies from compose.dev.yml
DATABASE_URL=postgresql://shopsphere:replace_with_local_password@localhost:5432/shopsphere?schema=public
REDIS_URL=redis://localhost:6379

# Use at least 32 random characters; never reuse this example in production
SESSION_SECRET=replace_with_at_least_32_random_characters

# Seed-only values for the local development administrator
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace_with_a_local_development_password

# Frontend
VITE_API_URL=http://localhost:4000/api/v1

# Tests must use isolated resources. Never point this at the development database.
TEST_DATABASE_URL=postgresql://shopsphere:replace_with_local_password@localhost:5432/shopsphere_test?schema=public
TEST_REDIS_URL=redis://localhost:6379/1
